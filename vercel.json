{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run lint && npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/__/:path*",
      "destination": "https://fspade-blog.firebaseapp.com/__/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
