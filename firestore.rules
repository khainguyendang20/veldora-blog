rules_version = '2';

// Role and status codes mirror src/utils/constants.js:
//   role:        1 = admin, 2 = mod, 3 = user
//   user status: 1 = active, 2 = pending, 3 = banned
//   post status: 1 = approved, 2 = pending, 3 = rejected
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Banned users, and users whose profile was deleted, cannot write
    function isActive() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.get('status', 1) != 3;
    }

    function isAdmin() {
      return isActive() && get(profilePath()).data.role == 1;
    }

    function isStaff() {
      return isActive() && get(profilePath()).data.role in [1, 2];
    }

    match /users/{userId} {
      // Profiles are public (author boxes, profile pages), so they hold no
      // email; that lives in userEmails
      allow read: if true;

      // Registration: own document only, as an active regular user, and
      // nothing beyond the public profile fields (never a password)
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
          ['fullname', 'avatar', 'username', 'role', 'status', 'createdAt'])
        && request.resource.data.role == 3
        && request.resource.data.status == 1;

      // Users edit their own profile fields; role and status are admin-only
      allow update: if isAdmin()
        || (isActive()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullname', 'avatar', 'description']));

      allow delete: if isAdmin();

      // Posts a user saved for later, keyed by post id; private to them
      match /bookmarks/{postId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Authors this user follows, keyed by author uid; private to them
      match /following/{authorId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create: if isActive()
          && request.auth.uid == userId
          && authorId != userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Likes and comments on this user's posts, written by the reader in
      // the same batch as the like or comment
      match /notifications/{notificationId} {
        function postDoc(id) {
          return /databases/$(database)/documents/posts/$(id);
        }

        function isValidLike(data) {
          return notificationId == 'like_' + data.postId + '_' + request.auth.uid
            && existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(request.auth.uid));
        }

        function isValidComment(data) {
          return notificationId == 'comment_' + data.commentId
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId))
              .data.user.id == request.auth.uid;
        }

        allow read: if signedIn() && request.auth.uid == userId;

        allow create: if isActive()
          && userId != request.auth.uid
          && request.resource.data.keys().hasOnly(['type', 'postId', 'postSlug',
            'postTitle', 'actor', 'commentId', 'read', 'createdAt'])
          && request.resource.data.actor.id == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && get(postDoc(request.resource.data.postId)).data.user.id == userId
          && ((request.resource.data.type == 'like' && isValidLike(request.resource.data))
            || (request.resource.data.type == 'comment' && isValidComment(request.resource.data)));

        // The owner only marks notifications as read
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        // Owners clear theirs; readers withdraw theirs when unliking or
        // deleting a comment (even if the owner already cleared it); staff
        // when moderating comments
        allow delete: if signedIn() && (request.auth.uid == userId
          || resource == null
          || resource.data.actor.id == request.auth.uid
          || isStaff());
      }
    }

    // Private half of a profile: readable by its owner and admins only
    match /userEmails/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      // Written at registration with the account's own email; admins may
      // write any (the migration script runs as an admin)
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email.lower()
            == request.auth.token.email.lower());
      allow update, delete: if isAdmin();
    }

    match /posts/{postId} {
      function isAuthor() {
        return signedIn() && resource.data.user.id == request.auth.uid;
      }

      function postPath() {
        return /databases/$(database)/documents/posts/$(postId);
      }

      function changesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(fields);
      }

      function changesAny(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(fields);
      }

      function movedBy(field, delta) {
        return request.resource.data.get(field, 0)
          == resource.data.get(field, 0) + delta;
      }

      // likeCount and commentCount move by exactly one, in the same batch
      // as the like or comment that justifies the change
      function isCounterUpdate() {
        let like = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
        let comment = /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.get('lastCommentId', '-'));
        return isActive() && (
          (changesOnly(['likeCount']) && (
            (movedBy('likeCount', 1) && !exists(like) && existsAfter(like))
            || (movedBy('likeCount', -1) && exists(like) && !existsAfter(like))))
          || (changesOnly(['commentCount', 'lastCommentId']) && (
            (movedBy('commentCount', 1) && !exists(comment) && existsAfter(comment))
            || (movedBy('commentCount', -1) && exists(comment) && !existsAfter(comment)))));
      }

      // Anyone reads approved posts; authors and staff also see the rest.
      // Public queries must therefore filter on status == 1.
      allow read: if resource.data.status == 1 || isAuthor() || isStaff();

      // Regular users submit posts for review: pending and not featured
      allow create: if isActive()
        && request.resource.data.user.id == request.auth.uid
        && (isStaff()
          || (request.resource.data.status == 2
            && request.resource.data.get('featured', false) == false));

      // Authors edit their own posts but cannot change who wrote them, the
      // moderation fields or the counters
      allow update: if isStaff()
        || isCounterUpdate()
        || (isActive()
          && isAuthor()
          && request.resource.data.user.id == resource.data.user.id
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('featured', false)
            == resource.data.get('featured', false)
          && !changesAny(['likeCount', 'commentCount', 'lastCommentId']));

      allow delete: if isStaff() || (isActive() && isAuthor());

      function post() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }

      function isPostAuthor() {
        return signedIn() && post().user.id == request.auth.uid;
      }

      match /comments/{commentId} {
        // As visible as the post they belong to
        allow read: if post().status == 1 || isPostAuthor() || isStaff();

        // Active users comment on published posts under their own name
        allow create: if isActive()
          && post().status == 1
          && request.resource.data.keys().hasOnly(['content', 'user', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.user.id == request.auth.uid
          && request.resource.data.user.fullname
            == get(profilePath()).data.fullname
          && request.resource.data.createdAt == request.time
          && getAfter(postPath()).data.get('commentCount', 0)
            == post().get('commentCount', 0) + 1;

        // Commenters remove their own (with the counter); post authors and
        // staff moderate, and clear comments when deleting the post
        allow delete: if (signedIn()
            && resource.data.user.id == request.auth.uid
            && getAfter(postPath()).data.get('commentCount', 0)
              == post().get('commentCount', 0) - 1)
          || isPostAuthor()
          || isStaff();
      }

      // One document per reader who liked the post, keyed by their uid
      match /likes/{userId} {
        allow read: if post().status == 1 || isPostAuthor() || isStaff();
        allow create: if isActive()
          && request.auth.uid == userId
          && post().status == 1
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(postPath()).data.get('likeCount', 0)
            == post().get('likeCount', 0) + 1;
        // Readers unlike (with the counter); post authors and staff clear
        // likes when deleting the post
        allow delete: if (signedIn()
            && request.auth.uid == userId
            && getAfter(postPath()).data.get('likeCount', 0)
              == post().get('likeCount', 0) - 1)
          || isPostAuthor()
          || isStaff();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
